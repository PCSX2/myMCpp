<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ThirdPartyDir>$(SolutionDir)3rdparty\</ThirdPartyDir>
    <ThirdPartyBuildDir>$(ThirdPartyDir)build_msvc_$(Platform)\</ThirdPartyBuildDir>
    <ThirdPartyBuildDir Condition="$(Configuration.Contains('Clang'))">$(ThirdPartyDir)build_clang_$(Platform)\</ThirdPartyBuildDir>
    <ThirdPartyCMakeConfig>MinSizeRel</ThirdPartyCMakeConfig>
    <ThirdPartyCMakeConfig Condition="$(Configuration.StartsWith('Debug'))">Debug</ThirdPartyCMakeConfig>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(ThirdPartyDir)spdlog\include;
        $(ThirdPartyDir)glfw\include;
        $(ThirdPartyDir)glm;
        $(ThirdPartyDir)nlohmann_json\include;
        $(ThirdPartyDir)Vulkan-Headers\include;
        $(ThirdPartyDir)vma\include;
        $(ThirdPartyDir)zlib;
        $(ThirdPartyBuildDir)zlib;
        $(ThirdPartyDir)glad\include;
        $(ThirdPartyDir)SPIRV-Tools\include;
        $(ThirdPartyDir);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>SPDLOG_COMPILED_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(ThirdPartyBuildDir)glfw\src\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)spdlog\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)zlib\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)Vulkan-Loader\loader\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)glslang\glslang\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)glslang\SPIRV\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)glslang\glslang\OSDependent\Windows\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)SPIRV-Tools\source\$(ThirdPartyCMakeConfig);
        $(ThirdPartyBuildDir)SPIRV-Tools\source\opt\$(ThirdPartyCMakeConfig);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="$(Configuration.StartsWith('Debug'))">
    <Link>
      <AdditionalDependencies>
        glfw3.lib;
        spdlogd.lib;
        zsd.lib;
        vulkan-1.lib;
        glslangd.lib;
        MachineIndependentd.lib;
        GenericCodeGend.lib;
        OSDependentd.lib;
        glslang-default-resource-limitsd.lib;
        SPIRVd.lib;
        SPIRV-Tools.lib;
        SPIRV-Tools-opt.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="!$(Configuration.StartsWith('Debug'))">
    <Link>
      <AdditionalDependencies>
        glfw3.lib;
        spdlog.lib;
        zs.lib;
        vulkan-1.lib;
        glslang.lib;
        MachineIndependent.lib;
        GenericCodeGen.lib;
        OSDependent.lib;
        glslang-default-resource-limits.lib;
        SPIRV.lib;
        SPIRV-Tools.lib;
        SPIRV-Tools-opt.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
