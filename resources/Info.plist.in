<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<key>CFBundleExecutable</key>
	<string>myMCpp</string>

	<key>CFBundleIdentifier</key>
	<string>net.mymcpp.myMCpp</string>

	<key>CFBundleName</key>
	<string>myMCpp</string>

	<key>CFBundleIconFile</key>
	<string>icons/AppIcon.icns</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>CFBundleShortVersionString</key>
	<string>${MYMCPP_VERSION}</string>

	<key>CFBundleVersion</key>
	<string>${MYMCPP_VERSION}</string>

	<key>NSHumanReadableCopyright</key>
	<string>Licensed under GPL version 3</string>

	<key>LSMinimumSystemVersion</key>
	<string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>

	<key>NSHighResolutionCapable</key>
	<true/>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PlayStation 2 Memory Card</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>ps2</string>
				<string>mc2</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleTypeIconFile</key>
			<string>icons/AppIcon.icns</string>
		</dict>
	</array>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.mymcpp.memcard</string>
			<key>UTTypeDescription</key>
			<string>PlayStation 2 Memory Card</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ps2</string>
					<string>mc2</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.ini</string>
			<key>UTTypeDescription</key>
			<string>Configuration File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ini</string>
				</array>
			</dict>
		</dict>
	</array>

</dict>
</plist>