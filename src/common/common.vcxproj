<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)vsprops\project_configs.props" />
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{A1B2C3D4-E5F6-4A1B-8C9D-0E1F2A3B4C5D}</ProjectGuid>
    <RootNamespace>myMCpp-common</RootNamespace>
    <ProjectName>myMCpp-common</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset Condition="!$(Configuration.Contains('Clang'))">v145</PlatformToolset>
    <PlatformToolset Condition="$(Configuration.Contains('Clang'))">ClangCL</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="$(Configuration.Contains('Debug'))">true</UseDebugLibraries>
    <UseDebugLibraries Condition="!$(Configuration.Contains('Debug'))">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="$(Configuration.Contains('Release'))">true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(MSBuildThisFileDirectory)vsprops\project_defaults.props" />
    <Import Condition="$(Configuration.Contains('Debug'))" Project="$(MSBuildThisFileDirectory)vsprops\opt_debug.props" />
    <Import Condition="$(Configuration.Contains('Devel'))" Project="$(MSBuildThisFileDirectory)vsprops\opt_devel.props" />
    <Import Condition="$(Configuration.Contains('Release'))" Project="$(MSBuildThisFileDirectory)vsprops\opt_release.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />

  <!-- Project-specific settings -->
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command>call "$(MSBuildThisFileDirectory)..\..\3rdparty\build_deps.cmd" "$(Configuration)" $(Platform)
call "$(SolutionDir)scripts\generate_svnrev.cmd" "$(SolutionDir)" "$(SolutionDir)build\$(Platform)\$(Configuration)\generated"</Command>
      <Message>Building 3rdparty dependencies via CMake and generating svnrev.h...</Message>
    </PreBuildEvent>
    <ClCompile>
      <PreprocessorDefinitions>_LIB;UTF8PROC_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\core;$(SolutionDir)build\$(Platform)\$(Configuration)\generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="sjis.cpp" />
    <ClCompile Include="lzari.cpp" />
    <ClCompile Include="Logger.cpp" />
    <ClCompile Include="Error.cpp" />
    <ClCompile Include="WindowInfo.cpp" />
    <ClCompile Include="Config.cpp" />
    <ClCompile Include="BuildVersion.cpp" />
    <ClCompile Include="..\..\3rdparty\utf8proc\utf8proc.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="round.h" />
    <ClInclude Include="version.h" />
    <ClInclude Include="BuildVersion.h" />
    <ClInclude Include="sjis.h" />
    <ClInclude Include="lzari.h" />
    <ClInclude Include="Logger.h" />
    <ClInclude Include="Error.h" />
    <ClInclude Include="WindowInfo.h" />
    <ClInclude Include="Config.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
