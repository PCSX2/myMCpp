<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{0691406f-88be-4c72-9b2d-72f23d96e3df}</ProjectGuid>
    <RootNamespace>myMCpp</RootNamespace>
    <Keyword>QtVS_v304</Keyword>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)common\vsprops\project_configs.props" />
  <Import Project="$(MSBuildThisFileDirectory)common\vsprops\qt_settings.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="!$(Configuration.Contains('Clang'))">v145</PlatformToolset>
    <PlatformToolset Condition="$(Configuration.Contains('Clang'))">ClangCL</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="$(Configuration.Contains('Debug'))">true</UseDebugLibraries>
    <UseDebugLibraries Condition="!$(Configuration.Contains('Debug'))">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="$(Configuration.Contains('Release'))">true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(QtMsBuild)\Qt.props" />
    <Import Project="$(MSBuildThisFileDirectory)common\vsprops\project_defaults.props" />
    <Import Condition="$(Configuration.Contains('Debug'))" Project="$(MSBuildThisFileDirectory)common\vsprops\opt_debug.props" />
    <Import Condition="$(Configuration.Contains('Devel'))" Project="$(MSBuildThisFileDirectory)common\vsprops\opt_devel.props" />
    <Import Condition="$(Configuration.Contains('Release'))" Project="$(MSBuildThisFileDirectory)common\vsprops\opt_release.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />

  <!-- Project-specific settings -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)core;$(ProjectDir)core\formats;$(ProjectDir)common;$(ProjectDir)cli;$(ProjectDir)ui;$(SolutionDir)build\$(Platform)\$(Configuration)\generated;$(SolutionDir)build\$(Platform)\$(Configuration)\obj\myMCpp-qt\qt\uic;$(Qt_INCLUDEPATH_);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>
if not exist "$(TargetDir)translations" mkdir "$(TargetDir)translations"

set "QT_BIN=$(QtToolsPath)"
if not exist "%QT_BIN%\qmake.exe" if defined QTDIR set "QT_BIN=%QTDIR%\bin"

if not exist "%QT_BIN%\lrelease.exe" (
  echo Qt lrelease not found at "%QT_BIN%". Skipping translation generation.
  goto :after_lrelease
)

"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_af-ZA.ts" -qm "$(TargetDir)translations\myMCpp_af-ZA.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_ar-SA.ts" -qm "$(TargetDir)translations\myMCpp_ar-SA.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_ca-ES.ts" -qm "$(TargetDir)translations\myMCpp_ca-ES.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_cs-CZ.ts" -qm "$(TargetDir)translations\myMCpp_cs-CZ.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_da-DK.ts" -qm "$(TargetDir)translations\myMCpp_da-DK.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_de-DE.ts" -qm "$(TargetDir)translations\myMCpp_de-DE.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_el-GR.ts" -qm "$(TargetDir)translations\myMCpp_el-GR.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_en.ts" -qm "$(TargetDir)translations\myMCpp_en.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_en-US.ts" -qm "$(TargetDir)translations\myMCpp_en-US.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_es-ES.ts" -qm "$(TargetDir)translations\myMCpp_es-ES.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_fi-FI.ts" -qm "$(TargetDir)translations\myMCpp_fi-FI.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_fr-FR.ts" -qm "$(TargetDir)translations\myMCpp_fr-FR.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_he-IL.ts" -qm "$(TargetDir)translations\myMCpp_he-IL.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_hu-HU.ts" -qm "$(TargetDir)translations\myMCpp_hu-HU.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_id-ID.ts" -qm "$(TargetDir)translations\myMCpp_id-ID.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_it-IT.ts" -qm "$(TargetDir)translations\myMCpp_it-IT.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_ja-JP.ts" -qm "$(TargetDir)translations\myMCpp_ja-JP.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_ko-KR.ts" -qm "$(TargetDir)translations\myMCpp_ko-KR.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_nl-NL.ts" -qm "$(TargetDir)translations\myMCpp_nl-NL.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_no-NO.ts" -qm "$(TargetDir)translations\myMCpp_no-NO.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_pl-PL.ts" -qm "$(TargetDir)translations\myMCpp_pl-PL.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_pt-BR.ts" -qm "$(TargetDir)translations\myMCpp_pt-BR.qm"
