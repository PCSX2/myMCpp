"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_ro-RO.ts" -qm "$(TargetDir)translations\myMCpp_ro-RO.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_ru-RU.ts" -qm "$(TargetDir)translations\myMCpp_ru-RU.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_sr-SP.ts" -qm "$(TargetDir)translations\myMCpp_sr-SP.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_sv-SE.ts" -qm "$(TargetDir)translations\myMCpp_sv-SE.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_tr-TR.ts" -qm "$(TargetDir)translations\myMCpp_tr-TR.qm"
