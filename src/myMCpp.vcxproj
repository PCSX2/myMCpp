"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_zh-CN.ts" -qm "$(TargetDir)translations\myMCpp_zh-CN.qm"
"%QT_BIN%\lrelease.exe" "$(ProjectDir)ui\Translations\myMCpp_zh-TW.ts" -qm "$(TargetDir)translations\myMCpp_zh-TW.qm"

:after_lrelease
xcopy /Y /E /I "$(ProjectDir)..\resources" "$(TargetDir)resources"

if exist "%QT_BIN%\windeployqt.exe" (
  "%QT_BIN%\windeployqt.exe" --no-compiler-runtime "$(TargetPath)"
) else (
  echo Qt windeployqt not found at "%QT_BIN%". Qt DLLs/plugins will not be deployed.
)
      </Command>
      <Message>Generating translations and copying resources to output...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ResourceCompile Include="..\resources\myMCpp.rc" />
    <QtRcc Include="..\resources\resources.qrc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="common\common.vcxproj">
      <Project>{A1B2C3D4-E5F6-4A1B-8C9D-0E1F2A3B4C5D}</Project>
      <Name>myMCpp-common</Name>
    </ProjectReference>
    <ProjectReference Include="core\core.vcxproj">
      <Project>{B2C3D4E5-F6A1-4B2C-8D0E-1F2A3B4C5D6E}</Project>
      <Name>myMCpp-core</Name>
    </ProjectReference>
    <ProjectReference Include="cli\cli.vcxproj">
      <Project>{C3D4E5F6-A1B2-4C3D-8E1F-2A3B4C5D6E7F}</Project>
      <Name>myMCpp-cli</Name>
    </ProjectReference>
    <ProjectReference Include="ui\ui.vcxproj">
