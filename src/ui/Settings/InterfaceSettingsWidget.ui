 <class>InterfaceSettingsWidget</class>
 <widget class="QWidget" name="InterfaceSettingsWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>600</width>
    <height>600</height>
   </rect>
