         <string>Thumbnail Size:</string>
        </property>
        <property name="buddy">
         <cstring>thumbnailSizeSpinner</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="horizontalLayout">
